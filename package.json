{
  "name": "blue-ledger-desktop",
  "version": "1.3.2",
  "description": "Offline-first multi-tenant POS desktop client for Blue Ledger.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "blue-ledger",
    "pos",
    "electron",
    "offline-first",
    "multi-tenant"
  ],
  "author": "Blue Ledger",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "dependencies": {
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "exceljs": "^4.4.0",
    "node-thermal-printer": "^4.6.0",
    "pdf-to-printer": "^5.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/electron-window-state": "^2.0.34",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.23.0",
    "nanoid": "^5.1.16",
    "pdfjs-dist": "^6.2.108",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "node_modules/pdf-to-printer/**/*"
    ],
    "compression": "maximum",
    "appId": "com.blueledger.desktop",
    "productName": "Blue Ledger POS",
    "icon": "resources/icons/BLUE_LEDGER_1024.png",
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons"
      },
      {
        "from": "resources/.env.production",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "Blue-Ledger-POS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "Blue-Ledger-POS-${version}-${arch}.${ext}",
      "identity": null
    },
    "dmg": {
      "artifactName": "Blue-Ledger-POS-${version}-${arch}.${ext}"
    }
  }
}
