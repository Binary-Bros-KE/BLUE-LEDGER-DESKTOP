BLUE_LEDGER_ENV=production

# The Blue Ledger cloud API (SERVER folder) this install talks to for activation, license
# heartbeats, and the auto-update feed. Change this — and only this — whenever the server moves.
# Not a secret (it's just this app's own known server address), safe to bundle into every build.
BLUE_LEDGER_API_URL=https://server.blueledgerpos.app
