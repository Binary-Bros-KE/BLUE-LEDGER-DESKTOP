BLUE_LEDGER_ENV=development

# The Blue Ledger cloud API (SERVER folder) this install talks to for activation and license
# heartbeats — see main/services/license-service.ts. Change this — and only this — whenever the
# server moves (staging, production, a new host).
BLUE_LEDGER_API_URL=https://server.blueledgerpos.app

# Not yet wired to anything (see SYNC_ENDPOINTS in shared/constants/app.ts) — reserved for the
# future full data-sync engine, separate from activation/licensing above.
BLUE_LEDGER_SYNC_URL=https://server.blueledgerpos.app/sync

# Optional — points this install's SQLite database + images at a separate folder instead of the
# default userData location. Set this to a DIFFERENT path per terminal to run several independent
# "installations" side by side in dev (e.g. testing a monthly client and a lifetime client at the
# same time, without a second machine). Leave unset for normal single-instance dev.
# BLUE_LEDGER_DATA_DIR=C:\bl-dev-monthly
